<?xml version="1.0" encoding="utf-8"?>
<!--
  What FileProvider may hand to other apps: exported GPX files, a post's
  photo being shared (the viewer's Download, Android 8 and 9), the file a
  camera app writes a photo for a post into, and the log being shared.
-->
<paths>
    <cache-path name="gpx" path="gpx/" />
    <cache-path name="photos" path="photos/" />
    <files-path name="camera" path="camera/" />
    <cache-path name="logs" path="logs/" />
</paths>
